---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'FAQ — The Isle Cheats & Products',
      description:
        'Answers about The Isle ESP, utilities, HWID tools, blog guides and checkout at isle-cheats.com.',
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="Help center"
          title="FAQ — answers about isle-cheats products"
          desc="Pricing, utilities, safety, and blog topics for isle-cheats.com — in one place."
          titleId="faq-page-title"
          heading="h1"
        />
        <h2 class="mt-4 text-xl font-semibold normal-case text-foreground">Common topics on The Isle catalog</h2>
      </div>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" hideHeader />
</BaseLayout>
