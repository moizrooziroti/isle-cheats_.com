---
import '../../styles/product-cheat-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { productPages } from '../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../data/sectionIcons';
import { resolvePageSeo } from '../../config/seo';
import { PRODUCTS } from '../../config/site';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { productPath } from '../../utils/path';

const seo = resolvePageSeo('/products/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
];

function pageSlug(slug: string): string {
  if (slug === 'the-isle-hwid-spoofer') return 'hwid-spoofer';
  if (slug === 'ugc-account-recovery') return 'ugc';
  return slug;
}

const cards = PRODUCTS.map((entry, index) => ({
  entry,
  index,
  product: productPages.find((item) => item.slug === pageSlug(entry.slug)),
})).filter((card) => card.product);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.products.title,
      description: seo.description,
      url: '/products/',
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      cards.map((card) => ({
        name: card.entry.name,
        url: productPath(card.product!.slug),
      })),
    ),
  ]}
>
  <section class="overflow-x-hidden py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-3 sm:px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-3xl font-bold uppercase md:text-4xl">{t.site.name} — Products</h1>
      <p class="mt-3 max-w-3xl text-muted-foreground">{t.products.subtitle}</p>
      <div class="mt-8 grid grid-cols-2 items-stretch gap-3 sm:gap-5 lg:grid-cols-4 lg:gap-6">
        {cards.map((card) => (
          <CatalogCard
            label={card.product!.kind === 'tier' ? (card.product!.tier ?? card.product!.name) : (card.product!.category ?? 'Utility')}
            title={card.entry.name}
            href={productPath(card.product!.slug)}
            buyUrl={card.entry.ctaUrl}
            features={card.entry.keyFeatures}
            icon={card.product!.kind === 'tier' ? (cheatTierIcons[card.product!.name] ?? 'crosshair') : (productCategoryIcons[card.product!.category ?? ''] ?? 'package')}
            variant={card.product!.variant ?? (card.index === 0 ? 'popular' : undefined)}
            badge={card.product!.badge}
            buyLabel="Buy now"
            viewLabel="View details"
            maxFeatures={5}
            class="min-w-0"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
