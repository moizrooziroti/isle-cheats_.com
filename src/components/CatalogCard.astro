---
import type { IconName } from './icons/types';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  label: string;
  title: string;
  href: string;
  buyUrl: string;
  features: string[];
  more?: number;
  icon?: IconName;
  badge?: string;
  variant?: 'essential' | 'popular' | 'limited';
  buyLabel?: string;
  viewLabel?: string;
  maxFeatures?: number;
  class?: string;
}

const {
  label,
  title,
  href,
  buyUrl,
  features,
  more = 0,
  icon = 'package',
  badge,
  variant,
  buyLabel = 'Buy',
  viewLabel = 'View',
  maxFeatures = 6,
  class: className,
} = Astro.props;

const displayFeatures = features.slice(0, maxFeatures);
const buyAttrs = buyUrl.startsWith('http')
  ? { rel: 'sponsored noopener nofollow', target: '_blank' }
  : {};
const featured = variant === 'popular';

const statusBadgeIcon = (text: string): IconName => {
  if (/limited/i.test(text)) return 'alert';
  if (/private/i.test(label)) return 'shieldCheck';
  return 'circleCheck';
};
---

<Card
  class:list={[
    'catalog-card group relative flex h-full flex-col overflow-hidden border-border/80 bg-card/95 transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg hover:shadow-primary/10',
    featured && 'catalog-card--featured ring-1 ring-primary/25',
    className,
  ]}
  data-catalog-card
>
  {featured && <div class="catalog-card__shine" aria-hidden="true" />}
  <CardHeader class="catalog-card__header space-y-3 pb-2">
    <div class="flex min-w-0 flex-col gap-2">
      <CardTitle class="catalog-card__title text-base font-bold normal-case leading-snug tracking-tight sm:text-lg">
        <a href={href} class="text-foreground transition-colors hover:text-primary">
          {title}
        </a>
      </CardTitle>
      <div class="catalog-card__badges flex flex-wrap items-center gap-1.5">
        <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
          <Icon name={icon} size={12} class="shrink-0" />
          {label}
        </Badge>
        {
          badge && (
            <Badge tone="primary" appearance="soft" size="sm" class="catalog-card__badge gap-1">
              <Icon name={statusBadgeIcon(badge)} size={12} class="shrink-0" />
              {badge}
            </Badge>
          )
        }
        {variant === 'popular' && (
          <Badge tone="primary" appearance="solid" size="sm" class="catalog-card__badge gap-1">
            <Icon name="zap" size={12} class="shrink-0" />
            Best seller
          </Badge>
        )}
        {
          variant === 'limited' && !badge?.toLowerCase().includes('limited') && (
            <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
              <Icon name="alert" size={12} class="shrink-0" />
              Limited
            </Badge>
          )
        }
      </div>
    </div>
  </CardHeader>
  <CardContent class="catalog-card__content flex-1 pt-0">
    <ul class="catalog-card__features space-y-2.5 text-sm leading-snug text-muted-foreground">
      {displayFeatures.map((feature) => (
        <li class="flex items-start gap-2.5">
          <span class="catalog-card__check mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
            <Icon name="check" size={10} />
          </span>
          <span>{feature}</span>
        </li>
      ))}
      {more > 0 && <li class="text-xs text-muted-foreground/90">+{more} more on the product page</li>}
    </ul>
  </CardContent>
  <CardFooter class="catalog-card__footer mt-auto flex flex-col gap-2 border-t border-border/60 bg-muted/20 pt-4">
    <Button
      as="a"
      href={buyUrl}
      variant="primary"
      size="sm"
      class="catalog-card__buy w-full font-semibold shadow-md shadow-primary/25"
      {...buyAttrs}
    >
      {buyLabel}
      <Icon name="arrowRight" size={17} aria-hidden="true" />
    </Button>
    <Button as="a" href={href} variant="ghost" size="sm" class="catalog-card__view w-full text-muted-foreground hover:text-foreground">
      {viewLabel}
      <Icon name="arrowRight" size={16} aria-hidden="true" />
    </Button>
  </CardFooter>
</Card>
