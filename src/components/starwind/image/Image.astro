---
import { Image as AstroImage } from "astro:assets";

import { image } from "./variants";

type Props = Partial<import("astro/types").ComponentProps<typeof AstroImage>> & {
  inferSize?: boolean;
};

const { class: className, src, alt = "", inferSize = true, ...rest } = Astro.props;
// Astro's Image typings expect inferSize omitted (default) or exactly false; avoid `true`.
/* eslint-disable @typescript-eslint/no-explicit-any -- rest mirrors upstream Image API */
const extra = rest as any;
/* eslint-enable @typescript-eslint/no-explicit-any */
---

{
  src && (
    <AstroImage
      class={image({ class: className })}
      src={src}
      alt={alt}
      {...(!inferSize ? { inferSize: false } : {})}
      {...extra}
      data-slot="image"
    />
  )
}
